<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/map_settings_category">

        <SeekBarPreference
            app:key="default_zoom"
            app:title="@string/default_zoom_title"
            app:summary="@string/default_zoom_summary"
            app:defaultValue="12"
            app:min="4"
            android:max="20"
            app:showSeekBarValue="true" />

        <ListPreference
            app:key="map_type"
            app:title="@string/map_type_title"
            app:entries="@array/map_type_entries"
            app:entryValues="@array/map_type_values"
            app:defaultValue="NORMAL"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</PreferenceScreen>
